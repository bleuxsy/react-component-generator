{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 2; out=$(bun run test 2>&1) && exit 0; printf '%s\\n' \"$out\" | tail -n 40 >&2; echo '[test-gate] 테스트 실패로 커밋이 차단되었습니다. 실패한 테스트를 고친 뒤 다시 커밋하세요.' >&2; exit 2",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "커밋 전 테스트 실행 중 (bun run test)..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 2; out=$(bun run test 2>&1) && exit 0; printf '%s\\n' \"$out\" | tail -n 40 >&2; echo '[test-gate] 테스트 실패로 커밋이 차단되었습니다. 실패한 테스트를 고친 뒤 다시 커밋하세요.' >&2; exit 2",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "커밋 전 테스트 실행 중 (bun run test)..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/.npmrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*\\.env*)",
      "Bash(*.pem*)",
      "Bash(*credential*)",
      "Bash(*secret*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(printenv*)",
      "PowerShell(* .env*)",
      "PowerShell(*/.env*)",
      "PowerShell(*\\.env*)",
      "PowerShell(*.pem*)",
      "PowerShell(*credential*)",
      "PowerShell(*secret*)",
      "PowerShell(*id_rsa*)",
      "PowerShell(*id_ed25519*)",
      "PowerShell(*.ssh*)",
      "PowerShell(*.aws*)",
      "PowerShell(*Env:*)"
    ]
  }
}
